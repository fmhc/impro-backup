# impro-backup Konfiguration — Mode 600, wird per systemd/Skript als Umgebung geladen.

# Ziel-Repo (Beispiele):
#   sftp:backup@storage.example.net:/backups/$(hostname)
#   s3:https://fsn1.your-objectstorage.com/mein-bucket/impro     (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#   rclone:meinremote:backups/impro                               (+ rclone-Config unter /root/.config/rclone)
#   /mnt/backup/impro                                             (lokal, nur zum Testen)
RESTIC_REPOSITORY=sftp:backup@storage.example.net:/backups/webserver
RESTIC_PASSWORD_FILE=/etc/impro-backup/restic.pw

# Backend-Zugangsdaten (nur bei S3/B2 nötig)
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Benachrichtigung (ntfy-Topic; leer = keine). Fehler kommen mit Priority high, OK mit low.
#NTFY_URL=https://ntfy.example.net/backups
#NTFY_TOKEN=

# Retention (restic forget), Defaults: 7 / 4 / 6
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_MONTHLY=6
# Unvollständige Läufe (Exit 3) so lange aufheben (restic-Dauer, Default 14d)
#KEEP_PARTIAL=14d

# Anteil der Daten, den `impro-backup check` wirklich liest (Default 5%)
#CHECK_SUBSET=5%

# Datenbank: Default ist mysqldump mit /etc/impro-backup/my.cnf. Alternativ eigenes Kommando,
# das den Dump auf stdout schreibt, z.B. Postgres oder Docker:
#DB_DUMP_CMD="pg_dumpall -U postgres"
#DB_DUMP_CMD="docker exec db pg_dumpall -U postgres"
#DB_DUMP_NAME=db-all.sql

# Hostkennung für Snapshots (Default: hostname -s). Auf einem Ersatzserver den ALTEN Hostnamen setzen,
# dann findet restore die alten Sicherungen und run führt die Serie fort.
#IMPRO_HOST=web01

# Wartezeit in Sekunden auf das Lock, wenn ein anderer Lauf aktiv ist (Default 3600)
#LOCK_WAIT=3600

# restic-Cache (Default /var/cache/impro-backup)
#RESTIC_CACHE_DIR=/var/cache/impro-backup
